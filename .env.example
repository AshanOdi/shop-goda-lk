# Copy to .env.local and fill in. Only DATABASE_URL and BETTER_AUTH_SECRET are needed for `pnpm dev`;
# SMS, email and storage fall back to console/local implementations when their keys are empty.

# --- Required ---
DATABASE_URL=postgres://sidadiya:sidadiya@localhost:5432/sidadiya
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- App ---
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32 bytes, base64; encrypts shop secrets. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Cloudflare R2 (file storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_ASSETS_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=mail.sidadiya.com

# --- SMS (Text.lk) ---
TEXTLK_API_KEY=
TEXTLK_SENDER_ID=Sidadiya

# --- Background jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Payments (PayHere) ---
PAYHERE_SANDBOX=true
# Sidadiya's own account for Pro billing
SIDADIYA_PAYHERE_MERCHANT_ID=
SIDADIYA_PAYHERE_MERCHANT_SECRET=

# --- Plan ---
# OPEN QUESTION (SPEC 7.6): placeholder Rs 1,990
PRO_PLAN_PRICE_CENTS=199000
TRIAL_DAYS=14
